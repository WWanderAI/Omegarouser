<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bar_background"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnCloseSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/nav_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/settings_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#202124" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Adblock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_adblock_title"
                        android:textSize="16sp"
                        android:textColor="#202124" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_adblock_subtitle"
                        android:textSize="13sp"
                        android:textColor="#80868b" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAdblock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- Поисковик -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:text="@string/settings_search_engine_title"
                android:textSize="16sp"
                android:textColor="#202124" />

            <RadioGroup
                android:id="@+id/radioGroupSearchEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <RadioButton
                    android:id="@+id/radioGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Google"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioYandex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Яндекс"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioDuckDuckGo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="DuckDuckGo"
                    android:textSize="15sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- Разрешения сайтов -->
            <LinearLayout
                android:id="@+id/btnSitePermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_permissions_title"
                    android:textSize="16sp"
                    android:textColor="#202124" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_permissions_subtitle"
                    android:textSize="13sp"
                    android:textColor="#80868b" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- Собственная страница результатов поиска -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_custom_search_title"
                    android:textSize="16sp"
                    android:textColor="#202124" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/settings_custom_search_subtitle"
                    android:textSize="13sp"
                    android:textColor="#80868b" />

                <EditText
                    android:id="@+id/inputCseApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="@string/settings_cse_api_key_hint"
                    android:inputType="text"
                    android:singleLine="true"
                    android:background="@drawable/bg_address_bar"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputCseEngineId"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:hint="@string/settings_cse_id_hint"
                    android:inputType="text"
                    android:singleLine="true"
                    android:background="@drawable/bg_address_bar"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnSaveCseConfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_gravity="end"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/settings_save"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
